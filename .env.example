# Copy to .env (local override) or .env.development / .env.production as
# needed. Vite only loads variables prefixed VITE_ into the client bundle.
# Never put real secrets in a VITE_ variable — it ships to every browser.

# Backend API base URL. In dev, "/api" uses the Vite proxy (see
# vite.config.js) to reach the backend without CORS issues.
VITE_API_URL=

# Master "is the product live" switch — see src/App.jsx. "true" opens the
# full member app (dashboard, matches, etc); unset/"false" keeps only
# public/marketing + auth routes.
VITE_LAUNCH_READY=

# Opens /signup, /login, /forgot-password. Defaults to true automatically
# in dev (import.meta.env.DEV) — set explicitly only to override that, or
# to open auth in production once ready to launch.
VITE_AUTH_OPEN=
